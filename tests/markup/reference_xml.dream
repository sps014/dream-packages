    ).unwrap();
    Assert.eq(d19.root.unwrap().text_content(), "a<&'\"b<raw>");
    Assert.eq(d19.elements("a")[0].attribute("id").unwrap(), "line next end");
    let d20 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:2\"><a id=\"© &amp;copy;\">日本 😀</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d20.root.unwrap().text_content(), "日本 😀<raw>");
    Assert.eq(d20.elements("a")[0].attribute("id").unwrap(), "© &copy;");
    let d21 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:0\"><a id=\"a&lt;&amp;&#x27;&quot;b\">line\nnext\tend</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d21.root.unwrap().text_content(), "line\nnext\tend<raw>");
    Assert.eq(d21.elements("a")[0].attribute("id").unwrap(), "a<&'\"b");
    let d22 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:1\"><a id=\"line\nnext\tend\">© &amp;copy;</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d22.root.unwrap().text_content(), "© &copy;<raw>");
    Assert.eq(d22.elements("a")[0].attribute("id").unwrap(), "line next end");
    let d23 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:2\"><a id=\"日本 😀\">a&lt;&amp;&#x27;&quot;b</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d23.root.unwrap().text_content(), "a<&'\"b<raw>");
    Assert.eq(d23.elements("a")[0].attribute("id").unwrap(), "日本 😀");
    let d24 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:0\"><a id=\"a&lt;&amp;&#x27;&quot;b\">日本 😀</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d24.root.unwrap().text_content(), "日本 😀<raw>");
    Assert.eq(d24.elements("a")[0].attribute("id").unwrap(), "a<&'\"b");
    let d25 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:1\"><a id=\"line\nnext\tend\">日本 😀</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d25.root.unwrap().text_content(), "日本 😀<raw>");
    Assert.eq(d25.elements("a")[0].attribute("id").unwrap(), "line next end");
    let d26 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:2\"><a id=\"© &amp;copy;\">line\nnext\tend</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d26.root.unwrap().text_content(), "line\nnext\tend<raw>");
    Assert.eq(d26.elements("a")[0].attribute("id").unwrap(), "© &copy;");
    let d27 = MarkupDocument.parse_xml(
