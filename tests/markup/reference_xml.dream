    ).unwrap();
    Assert.eq(d27.root.unwrap().text_content(), "a<&'\"b<raw>");
    Assert.eq(d27.elements("a")[0].attribute("id").unwrap(), "© &copy;");
    let d28 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:1\"><a id=\"line\nnext\tend\">line\nnext\tend</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d28.root.unwrap().text_content(), "line\nnext\tend<raw>");
    Assert.eq(d28.elements("a")[0].attribute("id").unwrap(), "line next end");
    let d29 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:2\"><a id=\"日本 😀\"> café </a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d29.root.unwrap().text_content(), " café <raw>");
    Assert.eq(d29.elements("a")[0].attribute("id").unwrap(), "日本 😀");
    let d30 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:0\"><a id=\"日本 😀\">日本 😀</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
    Assert.eq(d30.root.unwrap().text_content(), "日本 😀<raw>");
    Assert.eq(d30.elements("a")[0].attribute("id").unwrap(), "日本 😀");
    let d31 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:1\"><a id=\"line\nnext\tend\">© &amp;copy;</a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
    ).unwrap();
