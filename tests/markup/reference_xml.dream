    Assert.eq(d31.elements("a")[0].attribute("id").unwrap(), "line next end");
    let d32 = MarkupDocument.parse_xml(
        "<r xmlns=\"urn:2\"><a id=\"a&lt;&amp;&#x27;&quot;b\"> café </a><!-- comment --><b><![CDATA[<raw>]]></b></r>"
