import system.testing;
import youtube_explode;

fun browse_fixture(): JsonValue {
    return Json.deserialize<JsonValue>(
        "{\"sidebar\": {\"playlistSidebarRenderer\": {\"items\": [{\"playlistSidebarPrimaryInfoRenderer\": {\"titleForm\": {\"inlineFormRenderer\": {\"formField\": {\"textInputFormFieldRenderer\": {\"value\": \"Playlist title\"}}}}, \"descriptionForm\": {\"inlineFormRenderer\": {\"formField\": {\"textInputFormFieldRenderer\": {\"value\": \"Description Ω\"}}}}, \"stats\": [{\"runs\": [{\"text\": \"12\"}, {\"text\": \" videos\"}]}], \"thumbnailRenderer\": {\"playlistCustomThumbnailRenderer\": {\"thumbnail\": {\"thumbnails\": [{\"url\": \"https://example.test/cover\", \"width\": 480, \"height\": 270}]}}}}}, {\"playlistSidebarSecondaryInfoRenderer\": {\"videoOwner\": {\"videoOwnerRenderer\": {\"title\": {\"runs\": [{\"text\": \"Creator Ω\"}]}, \"navigationEndpoint\": {\"browseEndpoint\": {\"browseId\": \"UC3xnGqlcL3y-GXz5N3wiTJQ\"}}}}}}]}}}"
    ).unwrap();
}

