module markup;
import system;
import system.collections;
import system.text;

internal static class MarkupXml {
    internal static fun scalar(cp: int): bool {
        return cp
            == 9
            || cp
            == 10
            || cp
            == 13
            || (cp >= 32 && cp <= 55295)
            || (cp >= 57344 && cp <= 65533) || (cp >= 65536 && cp <= 1114111);
    }

    internal static fun validate_characters(p: MarkupParser): void {
        let i = 0;
        while i < p.source.length {
            let cp = (int)p.source[i];
            if cp >= 55296 && cp <= 56319 && i + 1 < p.source.length {
                let lo = (int)p.source[i + 1];
                if lo >= 56320 && lo <= 57343 {
                    cp = 65536 + ((cp - 55296) << 10) + lo - 56320;
                    i = i + 1;
                }
            }
            if !MarkupXml.scalar(cp) {
                p.position = i;
                p.fail("invalid XML character");
                return;
            }
            i = i + 1;
        }
    }

    static fun start(cp: int): bool {
        return cp
            == 95
            || (cp >= 65 && cp <= 90)
            || (cp >= 97 && cp <= 122)
            || (cp >= 192 && cp <= 214)
            || (cp >= 216 && cp <= 246)
            || (cp >= 248 && cp <= 767)
            || (cp >= 880 && cp <= 893)
            || (cp >= 895 && cp <= 8191)
            || (cp >= 8204 && cp <= 8205)
            || (cp >= 8304 && cp <= 8591)
            || (cp >= 11264 && cp <= 12271)
            || (cp >= 12289 && cp <= 55295)
            || (cp >= 63744 && cp <= 64975)
            || (cp >= 65008 && cp <= 65533) || (cp >= 65536 && cp <= 983039);
    }

    internal static fun valid_name(name: string, qualified: bool = true): bool {
        if name == "" {
            return false;
        }
        let first = true;
        let colon = false;
        let i = 0;
        while i < name.length {
            let cp = (int)name[i];
            if cp >= 55296 && cp <= 56319 && i + 1 < name.length {
                let lo = (int)name[i + 1];
                if lo >= 56320 && lo <= 57343 {
                    cp = 65536 + ((cp - 55296) << 10) + lo - 56320;
                    i = i + 1;
                }
            }
            if cp == 58 {
                if !qualified {
                    first = false;
                    i = i + 1;
                    continue;
                }
                if first || colon || i + 1 == name.length {
                    return false;
                }
                colon = true;
                first = true;
            } else {
                if !MarkupXml.start(cp)
                    && (
                        first
                            || !(
                                cp
                                    == 45
                                    || cp
                                    == 46
                                    || cp
                                    == 183
                                    || (cp >= 48 && cp <= 57)
                                    || (cp >= 768 && cp <= 879) || (cp >= 8255 && cp <= 8256)
                            )
                    ) {
                    return false;
                }
                first = false;
            }
            i = i + 1;
        }
        return true;
    }

    internal static fun namespaces(p: MarkupParser, node: MarkupNode): void {
        let xml = "http://www.w3.org/XML/1998/namespace";
        let xmlns = "http://www.w3.org/2000/xmlns/";
        for (let attr in node.attrs) {
            if attr.name == "xmlns" || attr.name.starts_with("xmlns:") {
                let prefix = "";
                if attr.name != "xmlns" {
                    prefix = attr.name.substring(6, attr.name.length);
                }
                if prefix
                    == "xmlns"
                    || attr.value
                    == xmlns
                    || (prefix == "xml" && attr.value != xml)
                    || (prefix != "xml" && attr.value == xml) || (prefix != "" && attr.value == "") {
                    p.fail("invalid namespace declaration");
                    return;
                }
                node.namespaces[prefix] = attr.value;
                attr.uri_value = xmlns;
            }
        }
        let colon = node.name.index_of(':');
        if colon.is_some() {
            let prefix = node.name.substring(0, colon.unwrap());
            node.uri_value = MarkupXml.binding(p, node, prefix);
            if prefix == "xmlns" || node.uri_value == "" {
                p.fail("unbound element namespace prefix");
                return;
            }
        } else {
            node.uri_value = MarkupXml.binding(p, node, "");
        }
        let seen = Map<string, bool>();
        for (let attr in node.attrs) {
            let index = attr.name.index_of(':');
            if index.is_some() && attr.uri_value == "" {
                let prefix = attr.name.substring(0, index.unwrap());
                attr.uri_value = MarkupXml.binding(p, node, prefix);
                if attr.uri_value == "" {
                    p.fail("unbound attribute namespace prefix");
                    return;
                }
            }
            let key = attr.uri_value.length.to_string() + ":" + attr.uri_value + attr.local_name;
            if seen.contains(key) {
                p.fail("duplicate expanded attribute name");
                return;
            }
            seen[key] = true;
        }
    }

    static fun binding(p: MarkupParser, node: MarkupNode, prefix: string): string {
        let local = node.namespaces.get(prefix);
        if local.is_some() {
            return local.unwrap();
        }
        let i = p.stack.length;
        while i > 0 {
            i = i - 1;
            let value = p.stack[i].namespaces.get(prefix);
            if value.is_some() {
                return value.unwrap();
            }
        }
        return "";
    }

    internal static fun declaration(text: string): bool {
        let i = 0;
        let stage = 0;
        while i < text.length {
            let start = i;
            while i < text.length && text[i].is_alpha() {
                i = i + 1;
            }
            let name = text.substring(start, i);
            while i < text.length && MarkupParser.space(text[i]) {
                i = i + 1;
            }
            if i == text.length || text[i] != '=' {
                return false;
            }
            i = i + 1;
            while i < text.length && MarkupParser.space(text[i]) {
                i = i + 1;
            }
            if i == text.length {
                return false;
            }
            let quote = text[i];
            if quote != (char)39 && quote != '"' {
                return false;
            }
            i = i + 1;
            start = i;
            while i < text.length && text[i] != quote {
                i = i + 1;
            }
            if i == text.length {
                return false;
            }
            let value = text.substring(start, i);
            i = i + 1;
            if stage == 0 {
                if name != "version" || value != "1.0" {
                    return false;
                }
                stage = 1;
            } else if name == "encoding" && stage == 1 {
                if value == "" || !value[0].is_alpha() {
                    return false;
                }
                for (let c in value) {
                    if !c.is_alpha() && !c.is_digit() && c != '.' && c != '_' && c != '-' {
                        return false;
                    }
                }
                stage = 2;
            } else if name == "standalone" && stage <= 2 {
                if value != "yes" && value != "no" {
                    return false;
                }
                stage = 3;
            } else {
                return false;
            }
            if i < text.length && !MarkupParser.space(text[i]) {
                return false;
            }
            while i < text.length && MarkupParser.space(text[i]) {
                i = i + 1;
            }
        }
        return stage > 0;
    }
}
