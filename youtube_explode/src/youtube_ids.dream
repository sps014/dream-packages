module youtube_explode;
import system;
import system.text;
import system.net;

internal static class YoutubeIds {
    static fun valid(value: string, kind: string): bool {
        if value.trim().is_empty() {
            return false;
        }
        if kind == "video" && value.length != 11 {
            return false;
        }
        if kind == "channel" && (value.length != 24 || !value.starts_with("UC")) {
            return false;
        }
        if kind == "playlist" && value.length < 2 {
            return false;
        }
        if kind == "user" && value.length > 20 {
            return false;
        }
        let extra = "";
        if kind == "video" || kind == "channel" || kind == "playlist" || kind == "handle" {
            extra = "_-";
        }
        if kind == "handle" {
            extra = "_.-";
        }
        return Regex.compile("\\A[\\p{L}\\p{Nd}" + extra + "]+\\z").unwrap().test(value);
    }

    internal static fun parse(input: string, kind: string): Option<string> {
        if YoutubeIds.valid(input, kind) {
            return Option.Some(input);
        }
        let patterns: string[] = [];
        if kind == "video" {
            patterns = [
                "youtube\\..+?/watch.*?v=(.*?)(?:&|/|$)",
                "youtu\\.be/watch.*?v=(.*?)(?:\\?|&|/|$)",
                "youtu\\.be/(.*?)(?:\\?|&|/|$)",
                "youtube\\..+?/embed/(.*?)(?:\\?|&|/|$)",
                "youtube\\..+?/shorts/(.*?)(?:\\?|&|/|$)",
                "youtube\\..+?/live/(.*?)(?:\\?|&|/|$)"
            ];
        }
        if kind == "playlist" {
            patterns = [
                "youtube\\..+?/playlist.*?list=(.*?)(?:&|/|$)",
                "youtube\\..+?/watch.*?list=(.*?)(?:&|/|$)",
                "youtu\\.be/.*?/.*?list=(.*?)(?:&|/|$)",
                "youtube\\..+?/embed/.*?/.*?list=(.*?)(?:&|/|$)"
            ];
        }
        if kind == "channel" {
            patterns = ["youtube\\..+?/channel/(.*?)(?:\\?|&|/|$)"];
        }
        if kind == "handle" {
            patterns = ["youtube\\..+?/@(.*?)(?:\\?|&|/|$)"];
        }
        if kind == "user" {
            patterns = ["youtube\\..+?/user/(.*?)(?:\\?|&|/|$)"];
        }
        if kind == "slug" {
            patterns = ["youtube\\..+?/c/(.*?)(?:\\?|&|/|$)"];
        }
        for (let pattern in patterns) {
            let matched = Regex.compile(pattern).unwrap().match(input);
            if matched.length > 1 {
                let encoded = Url.parse("https://www.youtube.com/?value=" + matched[1]);
                if encoded.is_ok() {
                    let decoded = encoded.unwrap().query.get("value");
                    if decoded.is_some() && YoutubeIds.valid(decoded.unwrap(), kind) {
                        return decoded;
                    }
                }
            }
        }
        return Option.None;
    }
}
