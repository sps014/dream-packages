module youtube_explode;
import system;

/// A signed byte count with binary unit conversion and display formatting.
public class FileSize: Equatable<FileSize>, Comparable<FileSize> {
    value: long;

    /// Stores a signed count without scaling or rounding.
    public constructor(bytes: long) {
        this.value = bytes;
    }

    /// Exact count in bytes.
    public get bytes(): long {
        return this.value;
    }

    /// Binary kilobytes, dividing the exact count by 1024^1.
    public get kilobytes(): double {
        return (double)this.value / 1024.0d;
    }

    /// Binary megabytes, dividing the exact count by 1024^2.
    public get megabytes(): double {
        return (double)this.value / 1048576.0d;
    }

    /// Binary gigabytes, dividing the exact count by 1024^3.
    public get gigabytes(): double {
        return (double)this.value / 1073741824.0d;
    }

    /// Orders exact integer counts without floating-point conversion.
    public fun compare(borrow other: FileSize): int {
        return this.value < other.value ? -1 : (this.value > other.value ? 1 : 0);
    }

    /// True when the exact counts match.
    public fun equals(borrow other: FileSize): bool {
        return this.value == other.value;
    }

    /// Hashes the exact count for use in maps and sets.
    public override fun hash_code(): int {
        return this.value.hash_code();
    }

    /// Displays the largest binary unit, with at most two decimal digits.
    public override fun to_string(): string {
        return MediaUnits.format(this.value, ["B", "KB", "MB", "GB"]);
    }
}
