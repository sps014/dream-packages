module youtube_explode;
import system;
import system.net;

/// Fetches video metadata using watch pages and the upstream player-client fallbacks.
public class VideoClient {
    internal controller: VideoController;

    /// Shares the caller's HTTP connection pools; origin selects YouTube or a fixture/mirror.
    /// cookies supplies a native CookieJar for YouTube's consent and authenticated requests.
    /// Without a jar, native clients create one; Node supports stateless requests without a jar.
    public constructor(
        http: HttpClient,
        origin: string = "https://www.youtube.com",
        cookies: Option<CookieJar> = Option.None
    ) {
        this.controller = VideoController(YoutubeHttp(http, cookies), origin);
    }

    /// Fetches a watch page, then resolves a player response when inline data is absent.
    /// VisionOS is tried first and Android is used only for unavailable/unplayable responses.
    /// Preserves cancellation and typed transport/extraction failures; received bodies are closed.
    public async fun get(
        id: VideoId,
        token: Option<CancellationToken> = Option.None
    ): Result<Video, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        let watched = lifetime[0].controller.watch(id, effective).await;
        if watched.is_err() {
            return Result.Err(watched.unwrap_err());
        }
        let page = watched.unwrap();
        let response = page.response;
        if response.is_none() {
            let resolved = lifetime[0].controller.player(id, Option.None, effective).await;
            if resolved.is_err() {
                return Result.Err(resolved.unwrap_err());
            }
            response = Option.Some(resolved.unwrap());
        }
        return VideoMetadata.parse(
            id,
            response.unwrap(),
            page.upload_date,
            page.likes,
            page.dislikes
        );
    }
}
