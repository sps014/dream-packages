module youtube_explode;
import system;

/// Pixel dimensions of a thumbnail or video.
public class Resolution: Equatable<Resolution> {
    width_value: int;
    height_value: int;

    /// Creates pixel dimensions of a thumbnail or video.
    public constructor(width: int, height: int) {
        this.width_value = width;
        this.height_value = height;
    }

    /// Width in pixels.
    public get width(): int {
        return this.width_value;
    }

    /// Height in pixels.
    public get height(): int {
        return this.height_value;
    }

    /// Pixel area, using 64-bit arithmetic.
    public get area(): long {
        return (long)this.width_value * (long)this.height_value;
    }

    /// Compares exact width and height values.
    public fun equals(borrow other: Resolution): bool {
        return this.width_value == other.width_value && this.height_value == other.height_value;
    }

    /// Hashes both dimensions for maps and sets.
    public override fun hash_code(): int {
        return this.width_value.hash_code() ^ this.height_value.hash_code();
    }

    /// Displays width and height as WIDTHxHEIGHT.
    public override fun to_string(): string {
        return this.width_value.to_string() + "x" + this.height_value.to_string();
    }
}
