module youtube_explode;
import system;
import system.net;
import system.json;
import system.text;
import system.collections;
import system.io;

/// Resolves playable stream metadata, including signatures, DASH, and HTTP size verification.
public class StreamClient {
    http: HttpClient;
    controller: VideoController;
    cipher_value: Option<SignatureCipher>;

    /// Shares an HTTP client, its cookies and connection pools. origin can select an HTTP fixture/mirror.
    public constructor(http: HttpClient, origin: string = "https://www.youtube.com") {
        this.http = http;
        this.controller = VideoController(this.http, origin);
        this.cipher_value = Option.None;
    }

    async fun cipher(token: Option<CancellationToken>): Result<SignatureCipher, YoutubeError> {
        let lifetime = [this];
        if lifetime[0].cipher_value.is_some() {
            return Result.Ok(lifetime[0].cipher_value.unwrap());
        }
        let endpoint = YoutubeHttp.endpoint(lifetime[0].controller.origin, "/iframe_api");
        if endpoint.is_err() {
            return Result.Err(endpoint.unwrap_err());
        }
        let iframe = YoutubeHttp.text(
            lifetime[0].http,
            HttpRequest(HttpMethod.Get, endpoint.unwrap()),
            token
        ).await;
        if iframe.is_err() {
            return Result.Err(iframe.unwrap_err());
        }
        let matched = Regex.compile("player\\\\?/([0-9a-fA-F]{8})\\\\?/")
            .unwrap()
            .match(iframe.unwrap());
        if matched.length < 2 {
            return Result.Err(YoutubeError("extraction", "player version is missing"));
        }
        let player_url = YoutubeHttp.endpoint(
            lifetime[0].controller.origin,
            "/s/player/" + matched[1] + "/player_ias.vflset/en_US/base.js"
        );
        if player_url.is_err() {
            return Result.Err(player_url.unwrap_err());
        }
        let text = YoutubeHttp.text(
            lifetime[0].http,
            HttpRequest(HttpMethod.Get, player_url.unwrap()),
            token
        ).await;
        if text.is_err() {
            return Result.Err(text.unwrap_err());
        }
        let parsed = SignatureCipher.parse(text.unwrap());
        if parsed.is_ok() {
            lifetime[0].cipher_value = Option.Some(parsed.unwrap());
        }
        return parsed;
    }

    static fun needs_cipher(response: JsonValue): bool {
        let data = YoutubeJson.path(response, ["streamingData"]);
        for (let key in ["formats", "adaptiveFormats"]) {
            let formats = YoutubeJson.path(data, [key]);
            let i = 0;
            while formats.is_array() && i < formats.length {
                let format = formats.at(i).unwrap();
                let raw = YoutubeJson.path(format, ["cipher"]).as_string();
                if raw.is_none() {
                    raw = YoutubeJson.path(format, ["signatureCipher"]).as_string();
                }
                if raw.is_some() {
                    let url = Url.parse("https://www.youtube.com/?" + raw.unwrap());
                    if url.is_ok() && !url.unwrap().query.get("s").unwrap_or("").is_empty() {
                        return true;
                    }
                }
                i = i + 1;
            }
        }
        return false;
    }

    async fun verified(
        stream: StreamInfo,
        token: Option<CancellationToken>
    ): Result<StreamProbe, YoutubeError> {
        let lifetime = [this];
        let length = stream.content_length;
        if length.is_none() {
            let target = Url.parse(stream.url);
            if target.is_err() {
                return Result.Err(YoutubeError("extraction", "invalid stream URL"));
            }
            let sent = lifetime[0]
                .http.send(HttpRequest(HttpMethod.Head, target.unwrap()), token)
                .await;
            if sent.is_err() {
                let error = sent.unwrap_err();
                return Result.Err(
                    YoutubeError(
                        error.code() == "ECANCELLED" ? "cancelled" : "http",
                        error.message()
                    )
                );
            }
            let response = sent.unwrap();
            let status = response.status;
            let header = response.headers.get("Content-Length");
            response.close();
            if status == 404 {
                return Result.Ok(StreamProbe(Option.None));
            }
            if status < 200 || status >= 300 {
                return Result.Err(
                    YoutubeError(
                        status == 429 ? "rate_limited" : "http",
                        "stream HEAD returned HTTP " + status.to_string()
                    )
                );
            }
            if header.is_some() {
                let parsed = long.parse(header.unwrap());
                if parsed.is_ok() && parsed.unwrap() >= 0L {
                    length = Option.Some(parsed.unwrap());
                }
            }
        }
        if length.is_none() {
            return Result.Ok(StreamProbe(Option.None));
        }
        let size = length.unwrap();
        if size > 0L {
            let target = Url.parse(stream.url).unwrap();
            let start = size > 1L ? size - 2L : 0L;
            target.query.set("range", start.to_string() + "-" + (size - 1L).to_string());
            let sent = lifetime[0].http.send(HttpRequest(HttpMethod.Get, target), token).await;
            if sent.is_err() {
                let error = sent.unwrap_err();
                return Result.Err(
                    YoutubeError(
                        error.code() == "ECANCELLED" ? "cancelled" : "http",
                        error.message()
                    )
                );
            }
            let response = sent.unwrap();
            let status = response.status;
            response.close();
            if status == 404 {
                return Result.Ok(StreamProbe(Option.None));
            }
            if status < 200 || status >= 300 {
                return Result.Err(
                    YoutubeError(
                        status == 429 ? "rate_limited" : "http",
                        "stream size probe returned HTTP " + status.to_string()
                    )
                );
            }
        }
        return Result.Ok(StreamProbe(Option.Some(stream.with_length(size))));
    }

    async fun extract(
        response: JsonValue,
        token: Option<CancellationToken>
    ): Result<StreamManifest, YoutubeError> {
        let lifetime = [this];
        let cipher = lifetime[0].cipher_value;
        if StreamClient.needs_cipher(response) && cipher.is_none() {
            let resolved = lifetime[0].cipher(token).await;
            if resolved.is_err() {
                return Result.Err(resolved.unwrap_err());
            }
            cipher = Option.Some(resolved.unwrap());
        }
        let parsed = StreamManifest.from_player_response(response, cipher);
        if parsed.is_err() {
            return Result.Err(parsed.unwrap_err());
        }
        let manifest = parsed.unwrap();
        let candidates = List<StreamInfo>();
        for (let stream in manifest.streams) {
            candidates.push(stream);
        }
        if manifest.dash_manifest_url.is_some() {
            let url = Url.parse(manifest.dash_manifest_url.unwrap());
            if url.is_err() {
                return Result.Err(YoutubeError("extraction", "invalid DASH manifest URL"));
            }
            let body = YoutubeHttp.text(
                lifetime[0].http,
                HttpRequest(HttpMethod.Get, url.unwrap()),
                token
            ).await;
            if body.is_err()
                && body.unwrap_err()
                .code() != "http" && body.unwrap_err()
                .code() != "rate_limited" {
                return Result.Err(body.unwrap_err());
            }
            if body.is_ok() {
                let dash = StreamManifest.from_dash(body.unwrap());
                if dash.is_err() {
                    return Result.Err(dash.unwrap_err());
                }
                for (let stream in dash.unwrap().streams) {
                    candidates.push(stream);
                }
            }
        }
        let streams = List<StreamInfo>();
        for (let stream in candidates) {
            let verified = lifetime[0].verified(stream, token).await;
            if verified.is_err() {
                return Result.Err(verified.unwrap_err());
            }
            if verified.unwrap().value.is_some() {
                streams.push(verified.unwrap().value.unwrap());
            }
        }
        if streams.is_empty() {
            return Result.Err(YoutubeError("unplayable", "video contains no playable streams"));
        }
        return Result.Ok(
            StreamManifest(
                streams.take_array(),
                manifest.dash_manifest_url,
                manifest.hls_manifest_url
            )
        );
    }

    async fun resolve(
        id: VideoId,
        token: Option<CancellationToken>
    ): Result<StreamManifest, YoutubeError> {
        let lifetime = [this];
        let response = lifetime[0].controller.player(id, Option.None, token).await;
        if response.is_err() && response.unwrap_err().code() != "unplayable" {
            return Result.Err(response.unwrap_err());
        }
        if response.is_ok() {
            let parsed = lifetime[0].extract(response.unwrap(), token).await;
            if parsed.is_ok() || parsed.unwrap_err().code() != "unplayable" {
                return parsed;
            }
        }
        let cipher = lifetime[0].cipher(token).await;
        if cipher.is_err() {
            return Result.Err(cipher.unwrap_err());
        }
        let fallback = lifetime[0]
            .controller.player(id, Option.Some(cipher.unwrap().signature_timestamp), token)
            .await;
        if fallback.is_err() {
            return Result.Err(fallback.unwrap_err());
        }
        return lifetime[0].extract(fallback.unwrap(), token).await;
    }

    /// Fetches formats and DASH, resolving signatures and verifying reported sizes with HTTP probes.
    /// Unplayable responses use the TV client with a cached signature timestamp; transport failures retry five times.
    /// SABR-only and unavailable streams are skipped. Cancellation is never retried.
    public async fun get_manifest(
        id: VideoId,
        token: Option<CancellationToken> = Option.None
    ): Result<StreamManifest, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        let attempt = 0;
        while true {
            let result = lifetime[0].resolve(id, effective).await;
            if result.is_ok() || result.unwrap_err().code() != "http" || attempt >= 5 {
                return result;
            }
            attempt = attempt + 1;
        }
    }

    /// Returns an HLS manifest URL for a live video; unavailable endpoints return unplayable.
    public async fun get_hls_url(
        id: VideoId,
        token: Option<CancellationToken> = Option.None
    ): Result<string, YoutubeError> {
        let lifetime = [this];
        let response = lifetime[0]
            .controller.player(id, Option.None, CancellationToken.resolve(token))
            .await;
        if response.is_err() {
            return Result.Err(response.unwrap_err());
        }
        let url = YoutubeJson.path(response.unwrap(), ["streamingData", "hlsManifestUrl"])
            .as_string();
        if url.is_none() || url.unwrap().trim().is_empty() {
            return Result.Err(YoutubeError("unplayable", "video has no HLS manifest"));
        }
        return Result.Ok(url.unwrap());
    }

    /// Opens a seekable AsyncReader for metadata with a known nonnegative size and an HTTP(S) URL.
    /// The caller closes the returned stream. The shared HttpClient is left open.
    public async fun get(
        info: StreamInfo,
        token: Option<CancellationToken> = Option.None
    ): Result<MediaStream, YoutubeError> {
        let lifetime = [this];
        let url = Url.parse(info.url);
        if url.is_err()
            || (url.unwrap().scheme != "http" && url.unwrap().scheme != "https")
            || info.content_length.is_none() || info.content_length.unwrap() < 0L {
            return Result.Err(
                YoutubeError(
                    "invalid_input",
                    "stream requires an HTTP URL and a known nonnegative size"
                )
            );
        }
        let stream = MediaStream(lifetime[0].http, info);
        let initialized = stream.initialize(CancellationToken.resolve(token)).await;
        if initialized.is_err() {
            stream.close();
            let error = initialized.unwrap_err();
            return Result.Err(
                YoutubeError(error.code() == "ECANCELLED" ? "cancelled" : "http", error.message())
            );
        }
        return Result.Ok(stream);
    }

    /// Copies a stream to an AsyncWriter, leaving the destination open and flushing on success.
    /// Progress reports fractions in [0, 1] after completed writes. Partial output persists on failure.
    public async fun copy_to(
        info: StreamInfo,
        destination: AsyncWriter,
        progress: Option<fun(double): void> = Option.None,
        token: Option<CancellationToken> = Option.None
    ): Result<long, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        let opened = lifetime[0].get(info, effective).await;
        if opened.is_err() {
            return Result.Err(opened.unwrap_err());
        }
        let stream = opened.unwrap();
        let copied = StreamDownload.copy(stream, destination, progress, effective).await;
        stream.close();
        return copied;
    }

    /// Creates or truncates path, downloads into it, then closes the file on success or failure.
    /// Failures preserve partial files; cancellation before opening leaves the destination untouched.
    public async fun download(
        info: StreamInfo,
        path: string,
        progress: Option<fun(double): void> = Option.None,
        token: Option<CancellationToken> = Option.None
    ): Result<long, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        if CancellationToken.is_cancelled_opt(effective) {
            return Result.Err(YoutubeError("cancelled", "download cancelled"));
        }
        let opened = FileHandle.open_async(path, FileMode.Write, effective).await;
        if opened.is_err() {
            let error = opened.unwrap_err();
            return Result.Err(
                YoutubeError(error.code() == "ECANCELLED" ? "cancelled" : "io", error.message())
            );
        }
        let file = opened.unwrap();
        let copied = lifetime[0].copy_to(info, file, progress, effective).await;
        let closed = file.close();
        if copied.is_ok() && closed.is_err() {
            return Result.Err(YoutubeError("io", closed.unwrap_err().message()));
        }
        return copied;
    }
}
