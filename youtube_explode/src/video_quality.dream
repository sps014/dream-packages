module youtube_explode;
import system;
import system.text;

/// A YouTube quality label, maximum display height, and frame rate.
public class VideoQuality: Equatable<VideoQuality>, Comparable<VideoQuality> {
    label_value: string;
    height_value: int;
    rate_value: int;

    /// Creates quality metadata. max_height is in pixels and framerate is frames/second.
    public constructor(label: string, max_height: int, framerate: int) {
        this.label_value = label;
        this.height_value = max_height;
        this.rate_value = framerate;
    }

    /// Builds a standard quality label from a height and frame rate, rounding rates above 30 up to a multiple of ten for display.
    public constructor(max_height: int, framerate: int) {
        this.height_value = max_height;
        this.rate_value = framerate;
        this.label_value = VideoQuality.format_label(max_height, framerate);
    }

    static fun format_label(height: int, rate: int): string {
        let label = height.to_string() + "p";
        if rate > 30 {
            label = label + ((((long)rate + 9L) / 10L) * 10L).to_string();
        }
        return label;
    }

    /// Original YouTube label, including HDR/360-degree suffixes when present.
    public get label(): string {
        return this.label_value;
    }

    /// Maximum vertical resolution in pixels.
    public get max_height(): int {
        return this.height_value;
    }

    /// Frames per second.
    public get framerate(): int {
        return this.rate_value;
    }

    /// True for 1080p and higher.
    public get is_high_definition(): bool {
        return this.height_value >= 1080;
    }

    /// Parses labels such as 1080p, 720p60, 1080s, or 2160p60 HDR.
    /// A label without an explicit rate uses fallback_framerate. Invalid labels return extraction.
    public static fun parse(
        label: string,
        fallback_framerate: int = 24
    ): Result<VideoQuality, YoutubeError> {
        let match = Regex.compile("^(\\d+)\\D(\\d+)?").unwrap().match(label);
        if match.length < 2 {
            return Result.Err(YoutubeError("extraction", "invalid video quality label"));
        }
        let height = int.parse(match[1]);
        let rate = fallback_framerate;
        if match.length > 2 && match[2] != "" {
            let parsed = int.parse(match[2]);
            if parsed.is_err() {
                return Result.Err(YoutubeError("extraction", "invalid quality frame rate"));
            }
            rate = parsed.unwrap();
        }
        if height.is_err() || height.unwrap() <= 0 || height.unwrap() > 1207959551 || rate <= 0 {
            return Result.Err(
                YoutubeError("extraction", "invalid quality dimensions or frame rate")
            );
        }
        return Result.Ok(VideoQuality(label, height.unwrap(), rate));
    }

    internal static fun from_itag(itag: int, rate: int): Result<VideoQuality, YoutubeError> {
        if rate <= 0 {
            return Result.Err(YoutubeError("extraction", "invalid quality frame rate"));
        }
        let height = switch (itag) {
            5 => 144,
            6 => 240,
            13 => 144,
            17 => 144,
            18 => 360,
            22 => 720,
            34 => 360,
            35 => 480,
            36 => 240,
            37 => 1080,
            38 => 3072,
            43 => 360,
            44 => 480,
            45 => 720,
            46 => 1080,
            59 => 480,
            78 => 480,
            82 => 360,
            83 => 480,
            84 => 720,
            85 => 1080,
            91 => 144,
            92 => 240,
            93 => 360,
            94 => 480,
            95 => 720,
            96 => 1080,
            100 => 360,
            101 => 480,
            102 => 720,
            132 => 240,
            151 => 144,
            133 => 240,
            134 => 360,
            135 => 480,
            136 => 720,
            137 => 1080,
            138 => 4320,
            142 => 240,
            143 => 360,
            144 => 480,
            145 => 720,
            146 => 1080,
            160 => 144,
            161 => 144,
            167 => 360,
            168 => 480,
            169 => 720,
            170 => 1080,
            212 => 480,
            213 => 480,
            214 => 720,
            215 => 720,
            216 => 1080,
            217 => 1080,
            218 => 480,
            219 => 480,
            222 => 480,
            223 => 480,
            224 => 720,
            225 => 720,
            226 => 1080,
            227 => 1080,
            242 => 240,
            243 => 360,
            244 => 480,
            245 => 480,
            246 => 480,
            247 => 720,
            248 => 1080,
            264 => 1440,
            266 => 2160,
            271 => 1440,
            272 => 2160,
            278 => 144,
            298 => 720,
            299 => 1080,
            302 => 720,
            303 => 1080,
            308 => 1440,
            313 => 2160,
            315 => 2160,
            330 => 144,
            331 => 240,
            332 => 360,
            333 => 480,
            334 => 720,
            335 => 1080,
            336 => 1440,
            337 => 2160,
            399 => 1080,
            398 => 720,
            397 => 480,
            396 => 360,
            395 => 240,
            394 => 144,
            _ => 0,
        };

        if height == 0 {
            return Result.Err(YoutubeError("extraction", "unrecognized video quality itag"));
        }
        return Result.Ok(VideoQuality(height, rate));
    }

    internal fun default_resolution(): Resolution {
        let height = this.height_value;
        let width = (int)((16L * (long)height) / 9L);
        if height == 144 {
            width = 256;
        }
        if height == 240 {
            width = 426;
        }
        if height == 360 {
            width = 640;
        }
        if height == 480 {
            width = 854;
        }
        if height == 720 {
            width = 1280;
        }
        if height == 1080 {
            width = 1920;
        }
        if height == 1440 {
            width = 2560;
        }
        if height == 2160 {
            width = 3840;
        }
        if height == 2880 {
            width = 5120;
        }
        if height == 3072 {
            width = 4096;
        }
        if height == 4320 {
            width = 7680;
        }
        return Resolution(width, height);
    }

    /// Orders maximum height, then frame rate, then the label ignoring case.
    public fun compare(borrow other: VideoQuality): int {
        if this.height_value != other.height_value {
            return this.height_value < other.height_value ? -1 : 1;
        }
        if this.rate_value != other.rate_value {
            return this.rate_value < other.rate_value ? -1 : 1;
        }
        return this.label_value.to_lower().compare(other.label_value.to_lower());
    }

    /// Compares height, frame rate, and case-insensitive label.
    public fun equals(borrow other: VideoQuality): bool {
        return this.height_value
            == other.height_value
            && this.rate_value
            == other.rate_value && this.label_value.to_lower() == other.label_value.to_lower();
    }

    /// Hashes all values used for equality.
    public override fun hash_code(): int {
        return this.label_value.to_lower()
            .hash_code() ^ this.height_value.hash_code() ^ this.rate_value.hash_code();
    }

    /// Displays the source quality label.
    public override fun to_string(): string {
        return this.label_value;
    }
}
