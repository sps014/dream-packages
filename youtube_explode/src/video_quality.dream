        if height == 0 {
            return Result.Err(YoutubeError("extraction", "unrecognized video quality itag"));
        }
        let label = height.to_string() + "p";
        if rate > 30 {
            label = label + ((((long)rate + 9L) / 10L) * 10L).to_string();
        }
        return Result.Ok(VideoQuality(label, height, rate));
    }

    internal fun default_resolution(): Resolution {
        let height = this.height_value;
        let width = (int)((16L * (long)height) / 9L);
        if height == 144 {
            width = 256;
        }
        if height == 240 {
            width = 426;
        }
        if height == 360 {
            width = 640;
        }
        if height == 480 {
            width = 854;
        }
        if height == 720 {
            width = 1280;
        }
        if height == 1080 {
            width = 1920;
        }
        if height == 1440 {
            width = 2560;
        }
        if height == 2160 {
            width = 3840;
        }
        if height == 2880 {
            width = 5120;
        }
        if height == 3072 {
            width = 4096;
        }
        if height == 4320 {
            width = 7680;
        }
        return Resolution(width, height);
    }
