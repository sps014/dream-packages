module youtube_explode;
import system;
import system.text;

/// A YouTube quality label, maximum display height, and frame rate.
public class VideoQuality {
    label_value: string;
    height_value: int;
    rate_value: int;

    /// Creates quality metadata. max_height is in pixels and framerate is frames/second.
    public constructor(label: string, max_height: int, framerate: int) {
        this.label_value = label;
        this.height_value = max_height;
        this.rate_value = framerate;
    }

    /// Original YouTube label, including HDR/360-degree suffixes when present.
    public get label(): string {
        return this.label_value;
    }

    /// Maximum vertical resolution in pixels.
    public get max_height(): int {
        return this.height_value;
    }

    /// Frames per second.
    public get framerate(): int {
        return this.rate_value;
    }

    /// True for 1080p and higher.
    public get is_high_definition(): bool {
        return this.height_value >= 1080;
    }

    /// Parses labels such as 1080p, 720p60, 1080s, or 2160p60 HDR.
    /// A label without an explicit rate uses fallback_framerate. Invalid labels return extraction.
    public static fun parse(
        label: string,
        fallback_framerate: int = 24
    ): Result<VideoQuality, YoutubeError> {
        let match = Regex.compile("^(\\d+)\\D(\\d+)?").unwrap().match(label);
        if match.length < 2 {
            return Result.Err(YoutubeError("extraction", "invalid video quality label"));
        }
        let height = int.parse(match[1]);
        let rate = fallback_framerate;
        if match.length > 2 && match[2] != "" {
            let parsed = int.parse(match[2]);
            if parsed.is_err() {
                return Result.Err(YoutubeError("extraction", "invalid quality frame rate"));
            }
            rate = parsed.unwrap();
        }
        if height.is_err() || height.unwrap() <= 0 || height.unwrap() > 1207959551 || rate <= 0 {
            return Result.Err(
                YoutubeError("extraction", "invalid quality dimensions or frame rate")
            );
        }
        return Result.Ok(VideoQuality(label, height.unwrap(), rate));
    }

