module youtube_explode;
import system;
import system.json;
import system.collections;

internal static class YoutubeRenderers {
    internal static fun descendants(root: JsonValue, name: string): JsonValue[] {
        let values = List<JsonValue>();
        let stack = List<JsonValue>();
        stack.push(root);
        while !stack.is_empty() {
            let value = stack.pop().unwrap();
            if value.is_object() {
                let matched = value.get(name);
                if matched.is_some() {
                    values.push(matched.unwrap());
                }
                let keys = value.keys();
                let i = keys.length - 1;
                while i >= 0 {
                    let key = keys[i];
                    let child = value.get(key).unwrap();
                    stack.push(child);
                    i = i - 1;
                }
            } else if value.is_array() {
                let i = value.length - 1;
                while i >= 0 {
                    stack.push(value.at(i).unwrap());
                    i = i - 1;
                }
            }
        }
        return values.take_array();
    }

    internal static fun thumbnails(
        values: JsonValue,
        output: List<Thumbnail>
    ): Result<Unit, YoutubeError> {
        let i = 0;
        while values.is_array() && i < values.length {
            let value = values.at(i).unwrap();
            let url = YoutubeJson.path(value, ["url"]).as_string().unwrap_or("");
            let width = YoutubeJson.path(value, ["width"]).as_int();
            let height = YoutubeJson.path(value, ["height"]).as_int();
            if url.is_empty()
                || width.is_none() || height.is_none() || width.unwrap() < 0 || height.unwrap() < 0 {
                return Result.Err(
                    YoutubeError(
                        "extraction",
                        "thumbnail URL or dimensions are missing or invalid"
                    )
                );
            }
            output.push(Thumbnail(url, Resolution(width.unwrap(), height.unwrap())));
            i = i + 1;
        }
        return Result.Ok(Unit());
    }

    internal static fun byline(value: JsonValue): JsonValue {
        for (let key in ["longBylineText", "shortBylineText"]) {
            let runs = YoutubeJson.path(value, [key, "runs"]);
            if runs.is_array() && runs.length > 0 {
                return runs.at(0).unwrap();
            }
        }
        return JsonValue.null();
    }

    internal static fun channel_id(author: JsonValue): string {
        let id = YoutubeJson.path(author, ["navigationEndpoint", "browseEndpoint", "browseId"])
            .as_string();
        if id.is_some() {
            return id.unwrap();
        }
        let endpoints = YoutubeRenderers.descendants(author, "browseEndpoint");
        if endpoints.length > 0 {
            return YoutubeJson.path(endpoints[0], ["browseId"]).as_string().unwrap_or("");
        }
        return "";
    }

    internal static fun duration(value: JsonValue): Option<double> {
        let seconds = YoutubeJson.number(YoutubeJson.path(value, ["lengthSeconds"]));
        if seconds.is_some() && seconds.unwrap() >= 0.0d && seconds.unwrap() <= 9000000000000.0d {
            return Option.Some(seconds.unwrap() * 1000.0d);
        }
        let text = YoutubeJson.text(YoutubeJson.path(value, ["lengthText"]));
        let parts = text.split(':');
        if parts.length < 2 || parts.length > 3 {
            return Option.None;
        }
        let total = 0L;
        let i = 0;
        for (let part in parts) {
            if part.is_empty() || part.length > 2 {
                return Option.None;
            }
            for (let c in part) {
                if c < '0' || c > '9' {
                    return Option.None;
                }
            }
            let parsed = long.parse(part);
            if parsed.is_err() || (i > 0 && (part.length != 2 || parsed.unwrap() >= 60L)) {
                return Option.None;
            }
            total = total * 60L + parsed.unwrap();
            i = i + 1;
        }
        return Option.Some((double)total * 1000.0d);
    }
}
