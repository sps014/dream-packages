module youtube_explode;
import system;

/// Metadata identifying one downloadable closed-caption track.
public class ClosedCaptionTrackInfo {
    url_value: string;

    /// Track URL supplied by YouTube.
    public get url(): string {
        return this.url_value;
    }

    language_value: Language;

    /// Track language tag and display name.
    public get language(): Language {
        return this.language_value;
    }

    is_auto_generated_value: bool;

    /// True for automatically generated captions.
    public get is_auto_generated(): bool {
        return this.is_auto_generated_value;
    }

    /// Creates caption-track metadata.
    public constructor(url: string, language: Language, is_auto_generated: bool) {
        this.url_value = url;
        this.language_value = language;
        this.is_auto_generated_value = is_auto_generated;
    }

    /// Displays this value in the upstream human-readable form.
    public override fun to_string(): string {
        return "CC Track (" + this.language_value.to_string() + ")";
    }
}
