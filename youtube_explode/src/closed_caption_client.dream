module youtube_explode;
import system;
import system.net;
import system.io;

/// Retrieves captions and writes SRT using a shared HTTP client and native YouTube cookie jar.
public class ClosedCaptionClient {
    http: YoutubeHttp;
    controller: VideoController;

    /// Shares the caller's HTTP connection pools; origin selects YouTube or a fixture/mirror.
    /// cookies supplies a native CookieJar for YouTube's consent and authenticated requests.
    /// Without a jar, native clients create one; Node supports stateless requests without a jar.
    public constructor(
        http: HttpClient,
        origin: string = "https://www.youtube.com",
        cookies: Option<CookieJar> = Option.None
    ) {
        this.http = YoutubeHttp(http, cookies);
        this.controller = VideoController(this.http, origin);
    }

    /// Fetches available caption tracks for a video using the player API and its client fallbacks.
    /// Missing captions return an empty manifest; remote/metadata failures preserve typed errors.
    public async fun get_manifest(
        id: VideoId,
        token: Option<CancellationToken> = Option.None
    ): Result<ClosedCaptionManifest, YoutubeError> {
        let lifetime = [this];
        let response = lifetime[0]
            .controller.player(id, Option.None, CancellationToken.resolve(token))
            .await;
        if response.is_err() {
            return Result.Err(response.unwrap_err());
        }
        return ClosedCaptionManifest.from_player_response(response.unwrap());
    }

    /// Fetches srv3 XML, setting both format=3 and fmt=3 while preserving other query parameters.
    /// HTTP/body/XML failures return YoutubeError; every received response body is closed.
    /// Cancellation follows the supplied token or the current structured task. The text limit is 16 MiB.
    public async fun get(
        track: ClosedCaptionTrackInfo,
        token: Option<CancellationToken> = Option.None
    ): Result<ClosedCaptionTrack, YoutubeError> {
        let lifetime = [this];
        let effective_token = CancellationToken.resolve(token);
        let url = Url.parse(track.url);
        if url.is_err() {
            return Result.Err(YoutubeError("invalid_input", "invalid caption-track URL"));
        }
        let target = url.unwrap();
        target.query.set("format", "3");
        target.query.set("fmt", "3");
        let request = HttpRequest(HttpMethod.Get, target);
        let sent = lifetime[0].http.send(request, effective_token).await;
        if sent.is_err() {
            let error = sent.unwrap_err();
            return Result.Err(YoutubeError(YoutubeHttp.category(error.code()), error.message()));
        }
        let response = sent.unwrap();
        if response.status < 200 || response.status >= 300 {
            let status = response.status;
            response.close();
            return Result.Err(
                YoutubeError(
                    status == 429 ? "rate_limited" : "http",
                    "caption request returned HTTP " + status.to_string()
                )
            );
        }
        let text = response.read_text(16777216, effective_token).await;
        response.close();
        if text.is_err() {
            let error = text.unwrap_err();
            return Result.Err(YoutubeError(YoutubeHttp.category(error.code()), error.message()));
        }
        if effective_token.is_some() && effective_token.unwrap().is_cancelled {
            return Result.Err(YoutubeError("cancelled", "caption download cancelled"));
        }
        return ClosedCaptionTrack.parse_xml(text.unwrap());
    }

    /// Fetches captions and writes numbered UTF-8 SRT cues to an AsyncWriter, leaving it open.
    /// Reports progress after each complete cue, flushes on success, and returns the byte count.
    /// Errors or cancellation preserve completed writes; an empty track reports no progress.
    public async fun write_to(
        track: ClosedCaptionTrackInfo,
        writer: AsyncWriter,
        progress: Option<fun(double): void> = Option.None,
        token: Option<CancellationToken> = Option.None
    ): Result<long, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        let fetched = lifetime[0].get(track, effective).await;
        if fetched.is_err() {
            return Result.Err(fetched.unwrap_err());
        }
        return CaptionOutput.write(fetched.unwrap(), writer, progress, effective).await;
    }

    /// Creates or truncates path, downloads a track as UTF-8 SRT, and closes the file on every outcome.
    /// Partial files remain on failure. Cancellation before opening leaves existing content untouched.
    public async fun download(
        track: ClosedCaptionTrackInfo,
        path: string,
        progress: Option<fun(double): void> = Option.None,
        token: Option<CancellationToken> = Option.None
    ): Result<long, YoutubeError> {
        let lifetime = [this];
        let effective = CancellationToken.resolve(token);
        if CancellationToken.is_cancelled_opt(effective) {
            return Result.Err(YoutubeError("cancelled", "caption download cancelled"));
        }
        let opened = FileHandle.open_async(path, FileMode.Write, effective).await;
        if opened.is_err() {
            let error = opened.unwrap_err();
            return Result.Err(
                YoutubeError(error.code() == "ECANCELLED" ? "cancelled" : "io", error.message())
            );
        }
        let writer = opened.unwrap();
        let output = lifetime[0].write_to(track, writer, progress, effective).await;
        let closed = writer.close();
        if output.is_ok() && closed.is_err() {
            return Result.Err(YoutubeError("io", closed.unwrap_err().message()));
        }
        return output;
    }
}
